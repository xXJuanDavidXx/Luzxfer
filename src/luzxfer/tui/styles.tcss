/* luzxfer — paleta.
   Fondo carbon, acento ambar: el portador de luz. Los codigos de estado
   llevan color semantico porque es lo que el ojo busca primero en una
   tabla de trafico. */

Screen {
    background: $lx-fondo;
    color: $lx-texto;
}

Header {
    background: $lx-panel;
    color: $lx-acento;
    text-style: bold;
}

Footer {
    background: $lx-panel;
    color: $lx-secundario;
}

Footer > .footer-key--key {
    background: $lx-elevado;
    color: $lx-acento;
    text-style: bold;
}

Footer > .footer-key--description {
    background: $lx-panel;
    color: $lx-atenuado;
}

/* ---------------------------------------------------------------- barra */
#barra {
    height: 3;
    background: $lx-panel;
    padding: 0 1;
    border-bottom: solid $lx-borde;
}

#barra Input {
    width: 1fr;
    background: $lx-fondo;
    color: $lx-texto;
    border: tall $lx-borde;
    padding: 0 1;
}

#barra Input:focus {
    border: tall $lx-acento;
}

#estado {
    width: auto;
    min-width: 34;
    content-align: right middle;
    color: $lx-secundario;
    padding: 1 1 0 2;
}

/* ---------------------------------------------------------------- tabla */
#flujos {
    height: 1fr;
    background: $lx-fondo;
    border: none;
    scrollbar-background: $lx-panel;
    scrollbar-color: $lx-separador;
    scrollbar-color-hover: $lx-acento;
    scrollbar-size: 1 1;
}

#flujos > .datatable--header {
    background: $lx-panel;
    color: $lx-secundario;
    text-style: bold;
}

#flujos > .datatable--cursor {
    background: $lx-superficie;
    color: $lx-texto;
    text-style: bold;
}

#flujos > .datatable--hover {
    background: $lx-elevado;
}

/* -------------------------------------------------------------- detalle */
#detalle {
    height: 50%;
    min-height: 8;
    border-top: solid $lx-borde;
    background: $lx-modal;
}

#detalle Tabs {
    background: $lx-panel;
}

#detalle Tab {
    color: $lx-secundario;
    padding: 0 2;
}

#detalle Tab.-active {
    color: $lx-acento;
    text-style: bold;
}

#detalle Underline > .underline--bar {
    color: $lx-acento;
    background: $lx-borde;
}

.panel {
    background: $lx-modal;
    color: $lx-cuerpo;
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
    scrollbar-background: $lx-panel;
    scrollbar-color: $lx-separador;
    scrollbar-size: 1 1;
}

/* ------------------------------------------------------------- repeater */
RepeaterScreen {
    align: center middle;
}

#rep-caja {
    width: 90%;
    height: 90%;
    background: $lx-modal;
    border: round $lx-acento;
    padding: 1 2;
}

#rep-titulo {
    color: $lx-acento;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#rep-editor {
    height: 1fr;
    background: $lx-fondo;
    color: $lx-texto;
    border: tall $lx-borde;
}

#rep-editor:focus {
    border: tall $lx-acento;
}

/* El borde y el alto van en el contenedor con scroll; la salida crece con
   su contenido. Con height: 1fr en la salida, una respuesta larga quedaba
   cortada al alto visible y no habia nada que desplazar. */
#rep-scroll {
    height: 1fr;
    background: $lx-fondo;
    border: tall $lx-borde;
    scrollbar-background: $lx-panel;
    scrollbar-color: $lx-separador;
    scrollbar-color-hover: $lx-acento;
    scrollbar-size: 1 1;
}

#rep-salida {
    height: auto;
    background: $lx-fondo;
    color: $lx-cuerpo;
    padding: 0 1;
}

#rep-barra {
    height: 3;
    align: left middle;
}

#rep-barra Button {
    margin-right: 2;
}

Button {
    background: $lx-elevado;
    color: $lx-texto;
    border: none;
    min-width: 12;
}

Button.-primary {
    background: $lx-acento;
    color: $lx-fondo;
    text-style: bold;
}

Button:hover {
    background: $lx-superficie;
}

Button.-primary:hover {
    background: $lx-acento_suave;
}

/* ------------------------------------------------------------ hallazgos */
#hallazgos {
    height: 1fr;
    background: $lx-modal;
}

#hallazgos > .datatable--header {
    background: $lx-panel;
    color: $lx-secundario;
}

#hallazgos > .datatable--cursor {
    background: $lx-superficie;
}

.vacio {
    color: $lx-tenue;
    padding: 2 2;
    text-style: italic;
}

/* selector de sesiones: misma caja modal que el repeater */
#ses-caja {
    width: 80%;
    height: 70%;
    background: $lx-modal;
    border: round $lx-acento;
    padding: 1 2;
}

#ses-titulo {
    height: 1;
    margin-bottom: 1;
}

#ses-tabla {
    height: 1fr;
}

#ses-ayuda {
    height: 1;
    margin-top: 1;
}

/* nota del flujo: caja chica, solo una linea de entrada */
#nota-caja {
    width: 70%;
    height: auto;
    background: $lx-modal;
    border: round $lx-acento;
    padding: 1 2;
}

#nota-titulo {
    height: 1;
    margin-bottom: 1;
}

#nota-ayuda {
    height: 1;
    margin-top: 1;
}

/* vista combinada: dos paneles al cincuenta por ciento */
#ambos {
    height: 1fr;
}

.mitad {
    width: 1fr;
}

#btn-vista {
    min-width: 20;
    height: 3;
    margin: 0 1;
}

/* intruder: peticion y configuracion arriba, resultados abajo */
#int-caja {
    width: 96%;
    height: 94%;
    background: $lx-modal;
    border: round $lx-acento;
    padding: 1 2;
}

#int-titulo { height: 1; margin-bottom: 1; }

#int-arriba { height: 40%; }

#int-editor { width: 2fr; }

#int-lado { width: 1fr; margin-left: 1; }

#int-payloads { height: 1fr; }

#int-botones { height: 3; }

#int-estado { height: 2; margin: 1 0; }

#int-resultados { height: 1fr; }

/* alcance: se edita como texto, una regla por linea */
#alc-caja {
    width: 76%;
    height: 80%;
    background: $lx-modal;
    border: round $lx-acento;
    padding: 1 2;
}

#alc-titulo { height: 1; margin-bottom: 1; }

#alc-editor { height: 1fr; }

#alc-ayuda { height: auto; margin-top: 1; }

#alc-aviso { height: auto; margin-top: 1; }

/* mapa del sitio */
#mapa-caja {
    width: 86%;
    height: 86%;
    background: $lx-modal;
    border: round $lx-acento;
    padding: 1 2;
}

#mapa-titulo { height: 1; margin-bottom: 1; }

#mapa { height: 1fr; }

/* interceptacion */
#itc-caja {
    width: 88%;
    height: 82%;
    background: $lx-modal;
    border: round $lx-peligro;
    padding: 1 2;
}

#itc-titulo { height: 1; margin-bottom: 1; }

#int-crudo { height: 1fr; }

#itc-ayuda { height: 1; margin-top: 1; }

/* matriz de cobertura WSTG */
#cob-caja {
    width: 94%;
    height: 90%;
    background: $lx-modal;
    border: round $lx-acento;
    padding: 1 2;
}

#cob-titulo { height: 1; margin-bottom: 1; }

#cob-tabla { height: 1fr; }

#cob-aviso { height: 2; margin-top: 1; }
