/* luzxfer — paleta.
   Fondo carbon, acento ambar: el portador de luz. Los codigos de estado
   llevan color semantico porque es lo que el ojo busca primero en una
   tabla de trafico. */

Screen {
    background: #0b0c10;
    color: #d9dde5;
}

Header {
    background: #14161c;
    color: #f0a93b;
    text-style: bold;
}

Footer {
    background: #14161c;
    color: #7b8496;
}

Footer > .footer-key--key {
    background: #1b1e26;
    color: #f0a93b;
    text-style: bold;
}

Footer > .footer-key--description {
    background: #14161c;
    color: #99a2b3;
}

/* ---------------------------------------------------------------- barra */
#barra {
    height: 3;
    background: #14161c;
    padding: 0 1;
    border-bottom: solid #262a35;
}

#barra Input {
    width: 1fr;
    background: #0b0c10;
    color: #d9dde5;
    border: tall #262a35;
    padding: 0 1;
}

#barra Input:focus {
    border: tall #f0a93b;
}

#estado {
    width: auto;
    min-width: 34;
    content-align: right middle;
    color: #7b8496;
    padding: 1 1 0 2;
}

/* ---------------------------------------------------------------- tabla */
#flujos {
    height: 1fr;
    background: #0b0c10;
    border: none;
    scrollbar-background: #14161c;
    scrollbar-color: #39404f;
    scrollbar-color-hover: #f0a93b;
    scrollbar-size: 1 1;
}

#flujos > .datatable--header {
    background: #14161c;
    color: #7b8496;
    text-style: bold;
}

#flujos > .datatable--cursor {
    background: #2a2f3d;
    color: #ffffff;
    text-style: bold;
}

#flujos > .datatable--hover {
    background: #1b1e26;
}

/* -------------------------------------------------------------- detalle */
#detalle {
    height: 50%;
    min-height: 8;
    border-top: solid #262a35;
    background: #0e1016;
}

#detalle Tabs {
    background: #14161c;
}

#detalle Tab {
    color: #7b8496;
    padding: 0 2;
}

#detalle Tab.-active {
    color: #f0a93b;
    text-style: bold;
}

#detalle Underline > .underline--bar {
    color: #f0a93b;
    background: #262a35;
}

.panel {
    background: #0e1016;
    color: #c7cdd9;
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
    scrollbar-background: #14161c;
    scrollbar-color: #39404f;
    scrollbar-size: 1 1;
}

/* ------------------------------------------------------------- repeater */
RepeaterScreen {
    align: center middle;
}

#rep-caja {
    width: 90%;
    height: 90%;
    background: #0e1016;
    border: round #f0a93b;
    padding: 1 2;
}

#rep-titulo {
    color: #f0a93b;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#rep-editor {
    height: 1fr;
    background: #0b0c10;
    color: #d9dde5;
    border: tall #262a35;
}

#rep-editor:focus {
    border: tall #f0a93b;
}

/* El borde y el alto van en el contenedor con scroll; la salida crece con
   su contenido. Con height: 1fr en la salida, una respuesta larga quedaba
   cortada al alto visible y no habia nada que desplazar. */
#rep-scroll {
    height: 1fr;
    background: #0b0c10;
    border: tall #262a35;
    scrollbar-background: #14161c;
    scrollbar-color: #39404f;
    scrollbar-color-hover: #f0a93b;
    scrollbar-size: 1 1;
}

#rep-salida {
    height: auto;
    background: #0b0c10;
    color: #c7cdd9;
    padding: 0 1;
}

#rep-barra {
    height: 3;
    align: left middle;
}

#rep-barra Button {
    margin-right: 2;
}

Button {
    background: #1b1e26;
    color: #d9dde5;
    border: none;
    min-width: 12;
}

Button.-primary {
    background: #f0a93b;
    color: #0b0c10;
    text-style: bold;
}

Button:hover {
    background: #2a2f3d;
}

Button.-primary:hover {
    background: #ffc062;
}

/* ------------------------------------------------------------ hallazgos */
#hallazgos {
    height: 1fr;
    background: #0e1016;
}

#hallazgos > .datatable--header {
    background: #14161c;
    color: #7b8496;
}

#hallazgos > .datatable--cursor {
    background: #2a2f3d;
}

.vacio {
    color: #5c6578;
    padding: 2 2;
    text-style: italic;
}

/* selector de sesiones: misma caja modal que el repeater */
#ses-caja {
    width: 80%;
    height: 70%;
    background: #0e1016;
    border: round #f0a93b;
    padding: 1 2;
}

#ses-titulo {
    height: 1;
    margin-bottom: 1;
}

#ses-tabla {
    height: 1fr;
}

#ses-ayuda {
    height: 1;
    margin-top: 1;
}

/* nota del flujo: caja chica, solo una linea de entrada */
#nota-caja {
    width: 70%;
    height: auto;
    background: #0e1016;
    border: round #f0a93b;
    padding: 1 2;
}

#nota-titulo {
    height: 1;
    margin-bottom: 1;
}

#nota-ayuda {
    height: 1;
    margin-top: 1;
}

/* vista combinada: dos paneles al cincuenta por ciento */
#ambos {
    height: 1fr;
}

.mitad {
    width: 1fr;
}

#btn-vista {
    min-width: 20;
    height: 3;
    margin: 0 1;
}

/* intruder: peticion y configuracion arriba, resultados abajo */
#int-caja {
    width: 96%;
    height: 94%;
    background: #0e1016;
    border: round #f0a93b;
    padding: 1 2;
}

#int-titulo { height: 1; margin-bottom: 1; }

#int-arriba { height: 40%; }

#int-editor { width: 2fr; }

#int-lado { width: 1fr; margin-left: 1; }

#int-payloads { height: 1fr; }

#int-botones { height: 3; }

#int-estado { height: 2; margin: 1 0; }

#int-resultados { height: 1fr; }
